# ------------------------------------------------------------------
# KINETIC backend - environment template
# Copy this file to `.env` and adjust the values.
#   copy .env.example .env      (PowerShell)
# ------------------------------------------------------------------

# --- Core ---
PORT=5000
NODE_ENV=development
# Number of proxies in front of the app (set to 1 behind a reverse proxy / render / nginx)
TRUST_PROXY=1
BODY_LIMIT=1mb

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/kinetic
# Example Atlas URI:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kinetic?retryWrites=true&w=majority

# --- JWT (THREE independent secrets - one per portal) ---
JWT_SECRET_ADMIN=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_SECRET_EMPLOYEE=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_SECRET_CUSTOMER=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7

# --- CORS ---
CLIENT_URL=http://localhost:5173

# --- Mail (leave SMTP_HOST empty to log mails to the console instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KINETIC <no-reply@kinetic.local>"
COMPANY_INBOX=hello@kinetic.local

# --- Seed / first admin account ---
ADMIN_NAME=KINETIC Founder
ADMIN_EMAIL=admin@kinetic.local
# NOTE: keep this value quoted - dotenv truncates unquoted values at `#`
ADMIN_PASSWORD="ChangeMe#Admin2026"
